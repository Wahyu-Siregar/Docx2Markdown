{
  "name": "docx2markdown",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first desktop application to convert Microsoft Word (.docx) documents into clean GitHub Flavored Markdown (GFM) with rich image handling, live split-view preview, and 100% local privacy.",
  "type": "module",
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/Wahyu-Siregar/Docx2Markdown#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wahyu-Siregar/Docx2Markdown.git"
  },
  "bugs": {
    "url": "https://github.com/Wahyu-Siregar/Docx2Markdown/issues"
  },
  "keywords": [
    "docx-to-markdown",
    "word-to-markdown",
    "docx2md",
    "word2md",
    "markdown-converter",
    "electron",
    "react",
    "typescript",
    "gfm",
    "local-first",
    "obsidian",
    "privacy-first",
    "desktop-app"
  ],
  "author": "Wahyu Siregar",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "dist": "npm run build && electron-builder --win nsis portable",
    "lint": "tsc --noEmit",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.wahyusiregar.docx2markdown",
    "productName": "Docx2Markdown",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Docx2Markdown"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fast-xml-parser": "^4.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
